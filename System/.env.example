# Tùy chọn: để trống nếu dùng giới hạn Community của Vnstock.
VNSTOCK_API_KEY=

# Khoảng nghỉ an toàn giữa các yêu cầu dữ liệu (giây).
VNSTOCK_REQUEST_INTERVAL=3.25

# Để trống/dùng mặc định: cửa sổ 8 năm trượt với gói Community.
# Chỉ đặt ngày cụ thể nếu gói dữ liệu của bạn hỗ trợ.
# VN100_HISTORY_START=2018-08-22
VN100_HISTORY_COUNT=5000
